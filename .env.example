# ==========================================================
# DRONE-MONITOR — Variáveis de Ambiente (Docker Compose)
# Copie este arquivo para ".env" caso queira customizar portas ou senhas.
# ==========================================================

# Banco de Dados MySQL 8
MYSQL_DATABASE=drone_monitor
MYSQL_ROOT_PASSWORD=root123
MYSQL_USER=drone_user
MYSQL_PASSWORD=drone123

# Se o MySQL local do seu Ubuntu já estiver rodando na porta 3306, altere para 3307
MYSQL_PORT=3306

# Back-End (Spring Boot)
API_PORT=8080
APP_JWT_SECRET=drone-monitor-secret-key-super-segura-com-mais-de-32-bytes-2026
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_SEED_ENABLED=true

# Front-End (Nuxt 3)
FRONTEND_PORT=3000
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
